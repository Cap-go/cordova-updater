{
  "name": "cordova-updater-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Example Cordova app for @capgo/cordova-updater",
  "scripts": {
    "start": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "cordova:prepare": "cordova prepare",
    "cordova:build:android": "cordova build android",
    "cordova:build:ios": "cordova build ios --emulator"
  },
  "devDependencies": {
    "@capgo/cordova-updater": "file:..",
    "cordova": "^12.0.0",
    "cordova-android": "^15.0.0",
    "cordova-ios": "^7.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.1"
  },
  "cordova": {
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {
      "@capgo/cordova-updater": {
        "APP_ID": "app.capgo.updater",
        "DEFAULT_CHANNEL": "",
        "UPDATE_URL": "http://10.0.2.2:3192/api/updates/manual-zip",
        "CHANNEL_URL": "http://10.0.2.2:3192/api/channel?scenario=manual-zip",
        "STATS_URL": "http://10.0.2.2:3192/api/stats?scenario=manual-zip",
        "AUTO_UPDATE": "false",
        "DIRECT_UPDATE": "false",
        "PUBLIC_KEY": " ",
        "APP_READY_TIMEOUT": "60000",
        "ALLOW_MODIFY_URL": "true",
        "ALLOW_MODIFY_APP_ID": "true",
        "ALLOW_MANUAL_BUNDLE_ERROR": "true",
        "ALLOW_SET_DEFAULT_CHANNEL": "true",
        "PERSIST_CUSTOM_ID": "true",
        "PERSIST_MODIFY_URL": "true",
        "SHAKE_MENU": "false",
        "AUTO_SPLASHSCREEN": "false"
      }
    }
  }
}
